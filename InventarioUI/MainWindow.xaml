<Window x:Class="InventarioUI.MainWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:views="clr-namespace:InventarioUI.Views"
            Title="Sistema de Inventario GAD"
            WindowStartupLocation="CenterScreen"
            Background="#F3F4F6"
            Opacity="0"
            WindowState="Maximized">

    <Window.Resources>

        <!-- BOTÓN MENÚ MODERNO -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D1E7D4"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="6">

                            <Grid>
                                <!-- INDICADOR ACTIVO -->
                                <Border x:Name="ActiveBar"
                                            Width="4"
                                            Background="#22C55E"
                                            HorizontalAlignment="Left"
                                            Visibility="Collapsed"
                                            CornerRadius="2"/>

                                <ContentPresenter Margin="10,0,0,0"/>
                            </Grid>

                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <!-- HOVER -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1F3B2B"/>
                </Trigger>

                <!-- ACTIVO -->
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#163427"/>
                </Trigger>

            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="#0F1F17">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <StackPanel Margin="20,25,20,10">

                    <TextBlock Text="G.A.D. CARACOL"
                                   Foreground="#A5D6A7"
                                   FontSize="22"
                                   FontWeight="Bold"/>

                    <TextBlock Text="Sistema de Inventario"
                                   Foreground="#6FAF87"
                                   FontSize="13"
                                   Margin="0,0,0,20"/>

                    <!-- USUARIO -->
                    <Border Background="#1C3A2C"
                                CornerRadius="10"
                                Padding="12">

                        <StackPanel>
                            <TextBlock Text="Usuario activo"
                                           FontSize="11"
                                           Foreground="#9FD6A9"/>

                            <TextBlock x:Name="txtUsuarioActivo"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                            <TextBlock x:Name="txtRolUsuario"
                                           FontSize="11"
                                           Foreground="#B7E4C7"/>
                        </StackPanel>

                    </Border>

                </StackPanel>

                <!-- MENÚ -->
                <Grid Grid.Row="1" Margin="12">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- MENÚ -->
                    <StackPanel Grid.Row="0">

                        <Button x:Name="btnDashboard" Style="{StaticResource MenuButton}" Margin="0,0,0,10" Click="BtnDashboard_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Dashboard"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnBienes" Style="{StaticResource MenuButton}" Margin="0,0,0,10" Click="BtnBienes_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Bienes"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnUbicaciones" Style="{StaticResource MenuButton}" Margin="0,0,0,10" Click="BtnUbicaciones_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Ubicaciones"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnMovimientosBienes" Style="{StaticResource MenuButton}" Margin="0,0,0,10" Click="BtnMovimientosBienes_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Movimientos"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnUsuarios" Style="{StaticResource MenuButton}" Margin="0,0,0,10" Click="BtnUsuarios_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Usuarios"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <!-- ESPACIO FLEXIBLE -->
                    <Grid Grid.Row="1"/>

                    <!-- LOGO CENTRADO -->
                    <Image Grid.Row="1"
           Source="/InventarioUI;component/Asset/logo_gad.png"
           Height="160"
           Stretch="Uniform"
           HorizontalAlignment="Center"
           Margin="0,-30,0,60"
           Opacity="0.9"/>

                </Grid>

                <StackPanel Grid.Row="2" Margin="12,0,12,20">

                    <!-- SEPARADOR -->
                    <Border Height="1" Background="#1C3A2C" Margin="0,0,0,12" Visibility="Collapsed" />

                    <!-- EXPORTAR -->
                    <Button Style="{StaticResource MenuButton}"
            Margin="0,0,0,6"
            Click="BtnExportarBackup_Click"
                            Visibility="Collapsed">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text=""
                       FontFamily="Segoe Fluent Icons"
                       FontSize="16"
                       Margin="0,0,10,0"/>
                            <TextBlock Text="Exportar respaldo"
                       FontSize="14"/>
                        </StackPanel>

                    </Button>

                    <!-- IMPORTAR -->
                    <Button Style="{StaticResource MenuButton}"
            Margin="0,0,0,12"
            Click="BtnImportarBackup_Click"
                            Visibility="Collapsed">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text=""
                       FontFamily="Segoe Fluent Icons"
                       FontSize="16"
                       Margin="0,0,10,0"/>
                            <TextBlock Text="Importar respaldo"
                       FontSize="14"/>
                        </StackPanel>

                    </Button>

                    <!-- BOTÓN SALIR (DESTACADO PERO ELEGANTE) -->
                    <Border CornerRadius="8" Background="#1F3B2B">

                        <Button x:Name="btnSalir"
                Background="Transparent"
                Foreground="#FCA5A5"
                Height="42"
                BorderThickness="0"
                Cursor="Hand"
                Click="BtnSalir_Click">

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text=""
                           FontFamily="Segoe Fluent Icons"
                           FontSize="18"
                           Margin="0,0,10,0"/>
                                <TextBlock Text="Cerrar sesión"
                           FontWeight="SemiBold"/>
                            </StackPanel>

                        </Button>

                    </Border>

                </StackPanel>

            </Grid>
        </Border>

        <!-- ================= CONTENIDO ================= -->
        <Grid Grid.Column="1" Margin="20">

            <!-- TARJETA PRINCIPAL -->
            <Border Background="White"
                        CornerRadius="12"
                        Padding="20">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                          ShadowDepth="2"
                                          Opacity="0.1"/>
                </Border.Effect>

                <ContentControl x:Name="MainContent"/>

            </Border>

        </Grid>

    </Grid>

    <!-- ANIMACIÓN -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0"
                                         To="1"
                                         Duration="0:0:0.25"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

</Window>   