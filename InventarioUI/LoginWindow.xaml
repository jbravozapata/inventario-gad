<Window x:Class="InventarioUI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="B-Inventory – Login"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Width="900" Height="520"
        Opacity="0">

    <!-- ===========================
         FONDO CON GRADIENTE
    ============================ -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F1F17" Offset="0"/>
            <GradientStop Color="#1B3A2B" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>

        <!-- BOTÓN ANIMADO -->
        <Style x:Key="AnimatedButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                To="#2FAE4F" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1.04" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1.04" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>

                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                To="#34C759" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- PANEL IZQUIERDO -->
        <Grid Background="#183026">
            <Image Source="/Logo.png"
                   Stretch="Uniform"
                   Width="299"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </Grid>

        <!-- PANEL DERECHO -->
        <Border Grid.Column="1"
                Background="#12241B"
                Padding="40"
                CornerRadius="10">

            <!-- SOMBRA -->
            <Border.Effect>
                <DropShadowEffect BlurRadius="25"
                                  ShadowDepth="0"
                                  Opacity="0.25"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">

                <!-- HEADER -->
                <TextBlock Foreground="#A5D6A7"
                           FontSize="32"
                           FontWeight="Bold"
                           Margin="0,0,0,5">
                    G.A.D. CARACOL
                </TextBlock>

                <TextBlock Text="INVENTARIO GENERAL"
                           Foreground="#6FAF87"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,30"/>

                <!-- USUARIO -->
                <TextBlock Text="Usuario"
                           Foreground="#D1D5DB"
                           Margin="0,0,0,5"/>

                <Border CornerRadius="8"
                        BorderThickness="1"
                        Margin="0,0,0,10"
                        Background="#1C3A2C">

                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#2E5C46"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFocused, ElementName=txtUsuario}" Value="True">
                                    <Setter Property="BorderBrush" Value="#34C759"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBox x:Name="txtUsuario"
                             Background="Transparent"
                             Foreground="White"
                             Padding="10"
                             BorderThickness="0"/>
                </Border>

                <!-- PASSWORD -->
                <TextBlock Text="Contraseña"
                           Foreground="#D1D5DB"
                           Margin="0,10,0,5"/>

                <Border CornerRadius="8"
                        BorderThickness="1"
                        Margin="0,0,0,20"
                        Background="#1C3A2C">

                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#2E5C46"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFocused, ElementName=txtPassword}" Value="True">
                                    <Setter Property="BorderBrush" Value="#34C759"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <PasswordBox x:Name="txtPassword"
                                 Background="Transparent"
                                 Foreground="White"
                                 Padding="10"
                                 BorderThickness="0"/>
                </Border>

               

                <!-- BOTÓN -->
                <Grid>

                    <Border CornerRadius="8" Background="#34C759">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10"
                              ShadowDepth="2"
                              Opacity="0.3"/>
                        </Border.Effect>

                        <Button x:Name="btnLogin"
                Style="{StaticResource AnimatedButton}"
                Background="#34C759"
                Click="btnLogin_Click">

                            <Grid>

                                <!-- TEXTO -->
                                <TextBlock x:Name="txtBtnLogin"
                           Text="INGRESAR"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                                <!-- LOADER -->
                                <TextBlock x:Name="txtLoading"
                           Text="Cargando..."
                           Visibility="Collapsed"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                            </Grid>

                        </Button>
                    </Border>

                </Grid>

                <!-- ERROR -->
                <TextBlock x:Name="lblMensaje"
                           Foreground="#FF6B6B"
                           FontSize="12"
                           Margin="0,15,0,0"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>

    <!-- ANIMACIÓN MEJORADA -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>

                    <!-- Fade -->
                    <DoubleAnimation
                        Storyboard.TargetProperty="Opacity"
                        From="0"
                        To="1"
                        Duration="0:0:0.4"/>

                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

</Window>