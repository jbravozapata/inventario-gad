<Window x:Class="InventarioUI.Views.UsuarioEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usuario"
        Width="420"
        Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F6F9">

    <Grid Margin="25">

        <Border Background="White"
                CornerRadius="10"
                Padding="25"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- NOMBRE -->
                <TextBlock Text="Nombre"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtNombre"
                         Grid.Column="1"
                         Margin="0,0,0,10"
                         Padding="6"/>


                <!-- USUARIO -->
                <TextBlock Text="Usuario"
                           Grid.Row="1"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtUsername"
                         Grid.Row="1"
                         Grid.Column="1"
                         Margin="0,0,0,10"
                         Padding="6"/>


                <!-- CONTRASEÑA -->
                <TextBlock Text="Contraseña"
                           Grid.Row="2"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <PasswordBox x:Name="txtPassword"
                             Grid.Row="2"
                             Grid.Column="1"
                             Margin="0,0,0,10"
                             Padding="6"/>


                <!-- ROL -->
                <TextBlock Text="Rol"
                           Grid.Row="3"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <ComboBox x:Name="cmbRol"
                          Grid.Row="3"
                          Grid.Column="1"
                          Margin="0,0,0,10">

                    <ComboBoxItem Content="Administrador"/>
                    <ComboBoxItem Content="Operador"/>
                    <ComboBoxItem Content="Consulta"/>

                </ComboBox>


                <!-- ACTIVO -->
                <TextBlock Text="Activo"
                           Grid.Row="4"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <CheckBox x:Name="chkActivo"
                          Grid.Row="4"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          IsChecked="True"/>


                <!-- BOTONES -->
                <StackPanel Grid.Row="5"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">

                    <Button Content="Guardar"
                            Width="110"
                            Height="34"
                            Margin="0,0,10,0"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            Click="BtnGuardar_Click"/>

                    <Button Content="Cancelar"
                            Width="110"
                            Height="34"
                            Background="#374151"
                            Foreground="White"
                            BorderThickness="0"
                            Click="BtnCancelar_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>
</Window>