<UserControl x:Class="InventarioUI.Views.MovimientosBienesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F3F0">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <TextBlock Text="Historial de movimientos de bienes"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#11261E"
                   Margin="0,0,0,20"/>

        <!-- TABLA -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="10"
                BorderBrush="#D1D5DB"
                BorderThickness="1">

            <DataGrid x:Name="dgMovimientosBienes"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Background="Transparent"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      RowHeight="34"
                      ColumnHeaderHeight="36"
                      AlternatingRowBackground="#F6F8F6"
                      BorderThickness="0">

                <!-- CABECERAS CENTRADAS (IGUAL QUE BIENESVIEW) -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Background" Value="#E8EFEA"/>
                        <Setter Property="Foreground" Value="#11261E"/>
                        <Setter Property="Padding" Value="6"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- CELDAS CENTRADAS (ESTA ERA LA DIFERENCIA) -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="6"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </Style>
                </DataGrid.CellStyle>

                <!-- COLUMNAS -->
                <DataGrid.Columns>

                    <DataGridTextColumn Header="FECHA"
                                        Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}"
                                        Width="160"/>

                    <DataGridTextColumn Header="TIPO"
                                        Binding="{Binding Tipo}"
                                        Width="140"/>

                    <DataGridTextColumn Header="CÓDIGO BIEN"
                                        Binding="{Binding Bien.CodigoContable}"
                                        Width="150"/>

                    <DataGridTextColumn Header="DESCRIPCIÓN"
                                        Binding="{Binding Bien.Descripcion}"
                                        Width="260"/>

                    <DataGridTextColumn Header="UBICACIÓN ORIGEN"
                                        Binding="{Binding UbicacionOrigen.Nombre}"
                                        Width="180"/>

                    <DataGridTextColumn Header="UBICACIÓN DESTINO"
                                        Binding="{Binding UbicacionDestino.Nombre}"
                                        Width="180"/>

                    <DataGridTextColumn Header="ESTADO ANTERIOR"
                                        Binding="{Binding EstadoAnterior}"
                                        Width="160"/>

                    <DataGridTextColumn Header="ESTADO NUEVO"
                                        Binding="{Binding EstadoNuevo}"
                                        Width="160"/>

                    <DataGridTextColumn Header="OBSERVACIÓN"
                                        Binding="{Binding Observacion}"
                                        Width="300"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>
</UserControl>
