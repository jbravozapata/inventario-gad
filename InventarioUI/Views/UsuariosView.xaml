<UserControl x:Class="InventarioUI.Views.UsuariosView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#F0F3F0">

    <UserControl.Resources>

        <!-- SOMBRA -->
        <DropShadowEffect x:Key="SoftShadow"
                          BlurRadius="12"
                          Opacity="0.12"
                          ShadowDepth="1"/>

        <!-- BOTÓN BASE -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Background" Value="#1B5E4A"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Background" Value="#4B5563"/>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="170"/>
            <Setter Property="Background" Value="#F59E0B"/>
        </Style>

        <Style x:Key="DarkButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="170"/>
            <Setter Property="Background" Value="#374151"/>
        </Style>

        <!-- HEADERS CENTRADOS -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F3"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <TextBlock Text="Usuarios del sistema"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#11261E"
                   Margin="0,0,0,15"/>

        <!-- TABLA -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Effect="{StaticResource SoftShadow}">

            <DataGrid x:Name="tablaUsuarios"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      RowHeight="38"
                      ColumnHeaderHeight="38"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      Background="Transparent"
                      GridLinesVisibility="None"
                      AlternatingRowBackground="#F9FAFB"
                      BorderThickness="0">

                <!-- CELDAS -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,4"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="#374151"/>
                        <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.CellStyle>

                <!-- FILAS -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Margin" Value="0,2,0,2"/>

                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EDF7F2"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D7EFE5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="60"/>

                    <DataGridTextColumn Header="Nombre"
                                        Binding="{Binding NombreCompleto}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Usuario"
                                        Binding="{Binding Username}"
                                        Width="160"/>

                    <DataGridTextColumn Header="Rol"
                                        Binding="{Binding Rol}"
                                        Width="140"/>

                    <DataGridCheckBoxColumn Header="Activo"
                                            Binding="{Binding Activo}"
                                            Width="90"/>

                    <DataGridTextColumn Header="Creado"
                                        Binding="{Binding FechaCreacion, StringFormat=dd/MM/yyyy HH:mm}"
                                        Width="180"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- BOTONES -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Nuevo usuario"
                    Style="{StaticResource PrimaryButton}"
                    Click="BtnNuevo_Click"/>

            <Button Content="Editar"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnEditar_Click"/>

            <Button Content="Cambiar contraseña"
                    Style="{StaticResource WarningButton}"
                    Click="BtnPassword_Click"/>

            <Button Content="Activar / Desactivar"
                    Style="{StaticResource DarkButton}"
                    Click="BtnEstado_Click"/>

        </StackPanel>

    </Grid>

</UserControl>