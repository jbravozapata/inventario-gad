<UserControl x:Class="InventarioUI.Views.UbicacionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F3F0">

    <UserControl.Resources>

        <!-- SOMBRA -->
        <DropShadowEffect x:Key="SoftShadow"
                          BlurRadius="12"
                          Opacity="0.12"
                          ShadowDepth="1"/>

        <!-- BOTONES -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#1B5E4A"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#4B5563"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#DC2626"/>
        </Style>

        <!-- HEADERS CENTRADOS -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F3"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <TextBlock Text="Gestión de ubicaciones"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#11261E"
                   Margin="0,0,0,15"/>

        <!-- TABLA -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Effect="{StaticResource SoftShadow}">

            <DataGrid x:Name="dgUbicaciones"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      Background="Transparent"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      RowHeight="38"
                      ColumnHeaderHeight="38"
                      AlternatingRowBackground="#F9FAFB"
                      BorderThickness="0"
                      MouseDoubleClick="DgUbicaciones_MouseDoubleClick">

                <!-- CELDAS CENTRADAS -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,4"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="#374151"/>
                        <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.CellStyle>

                <!-- FILAS -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Margin" Value="0,2,0,2"/>

                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EDF7F2"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D7EFE5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>

                    <!-- ID -->
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="60"/>

                    <!-- NOMBRE -->
                    <DataGridTextColumn Header="Nombre"
                                        Binding="{Binding Nombre}"
                                        Width="*"/>

                    <!-- BIENES -->
                    <DataGridTemplateColumn Header="Bienes" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#E6F4EA"
                                        CornerRadius="10"
                                        Padding="6,2"
                                        HorizontalAlignment="Center">

                                    <TextBlock Text="{Binding TotalBienes}"
                                               FontWeight="SemiBold"
                                               Foreground="#1B5E4A"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>
        </Border>

        <!-- BOTONES -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Nuevo"
                    Style="{StaticResource PrimaryButton}"
                    Click="BtnNuevo_Click"/>

            <Button Content="Editar"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnEditar_Click"/>

            <Button Content="Eliminar"
                    Style="{StaticResource DangerButton}"
                    Click="BtnEliminar_Click"/>

        </StackPanel>

    </Grid>
</UserControl>