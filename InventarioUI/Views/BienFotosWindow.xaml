<Window x:Class="InventarioUI.Views.BienFotosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fotos del bien"
        Width="700"
        Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F9FAFB">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================= -->
        <!-- ENCABEZADO -->
        <!-- ========================= -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock x:Name="txtTitulo"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#11261E"/>

            <TextBlock x:Name="txtSubtitulo"
                       FontSize="13"
                       Foreground="#6B7280"/>
        </StackPanel>

        <!-- ========================= -->
        <!-- GALERÍA DE FOTOS -->
        <!-- ========================= -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                Padding="10">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="itemsFotos">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="140"
                Height="160"
                Margin="6"
                CornerRadius="6"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Imagen -->
                                    <Image Source="{Binding}"
                                           Stretch="UniformToFill"
                                           Margin="4"
                                           Cursor="Hand"
                                           MouseLeftButtonUp="ImgFoto_Click"/>


                                    <!-- Botón eliminar -->
                                    <Button Grid.Row="1"
                                            Content="Eliminar"
                                            Height="26"
                                            Margin="4"
                                            Background="#6B7280"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Tag="{Binding}"
                                            Click="BtnEliminarFoto_Click"/>     
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ========================= -->
        <!-- BOTONES -->
        <!-- ========================= -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Agregar foto"
                    Width="140"
                    Height="36"
                    Background="#1B5E4A"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnAgregarFoto_Click"/>

            <Button Content="Cerrar"
                    Width="100"
                    Height="36"
                    Margin="10,0,0,0"
                    Background="#6B7280"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnCerrar_Click"/>
        </StackPanel>

    </Grid>
</Window>
