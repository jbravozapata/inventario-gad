<Window x:Class="InventarioUI.Views.UbicacionForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ubicación"
        Height="330"
        Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F4F6">

    <Window.Resources>

        <!-- SOMBRA -->
        <DropShadowEffect x:Key="SoftShadow"
                          BlurRadius="12"
                          Opacity="0.15"
                          ShadowDepth="1"/>

        <!-- BOTÓN BASE -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#1B5E4A"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#4B5563"/>
        </Style>

    </Window.Resources>


    <Grid Margin="20">

        <Border Background="White"
                CornerRadius="12"
                Padding="22"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                Effect="{StaticResource SoftShadow}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TÍTULO -->
                <StackPanel>

                    <TextBlock Text="Ubicación"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#11261E"/>

                    <TextBlock Text="Registrar o modificar una ubicación del inventario"
                               FontSize="12"
                               Foreground="#6B7280"
                               Margin="0,4,0,16"/>

                </StackPanel>

                <!-- INPUT -->
                <Grid Grid.Row="1" Margin="0,10,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Nombre de la ubicación"
               FontWeight="SemiBold"
               Foreground="#111827"
               Margin="0,0,0,6"/>

                    <TextBox x:Name="txtNombre"
             Grid.Row="1"
             Height="36"
             Padding="8"
             FontSize="14"
             Background="White"
             BorderBrush="#9CA3AF"
             BorderThickness="1"
             VerticalContentAlignment="Center"/>

                </Grid>

                <!-- BOTONES -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,22,0,0">

                    <Button Content="Guardar"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,10,0"
                            Click="BtnGuardar_Click"/>

                    <Button Content="Cancelar"
                            Style="{StaticResource SecondaryButton}"
                            Click="BtnCancelar_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>