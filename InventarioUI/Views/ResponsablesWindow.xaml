<Window x:Class="InventarioUI.Views.ResponsablesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Responsables"
        Width="420"
        Height="355"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F3F0">

    <Window.Resources>

        <!-- SOMBRA -->
        <DropShadowEffect x:Key="SoftShadow"
                          BlurRadius="15"
                          Opacity="0.15"
                          ShadowDepth="2"/>

        <!-- BOTÓN -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#1B5E4A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="20">

        <Border Background="White"
                CornerRadius="12"
                Padding="20"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Effect="{StaticResource SoftShadow}">

            <StackPanel>

                <!-- TÍTULO -->
                <TextBlock Text="Responsables del acta"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#11261E"
                           Margin="0,0,0,15"/>

                <!-- ENTREGA -->
                <TextBlock Text="Nombre de quien ENTREGA"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="2,0,0,5"/>

                <TextBox x:Name="txtEntrega"
                         Height="34"
                         Padding="8"
                         Background="#F9FAFB"
                         BorderBrush="#D1D5DB"
                         Margin="0,0,0,12"/>

                <!-- RECIBE -->
                <TextBlock Text="Nombre de quien RECIBE"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="2,0,0,5"/>

                <TextBox x:Name="txtRecibe"
                         Height="34"
                         Padding="8"
                         Background="#F9FAFB"
                         BorderBrush="#D1D5DB"
                         Margin="0,0,0,20"/>

                <!-- BOTONES -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Aceptar"
                            Width="100"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,10,0"
                            Click="BtnAceptar_Click"/>

                    <Button Content="Cancelar"
                            Width="100"
                            Background="#6B7280"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnCancelar_Click"/>

                </StackPanel>

            </StackPanel>

        </Border>

    </Grid>
</Window>